<RCC>
    <qresource prefix="/">
        <file>main.qml</file>
        <file>StereoHotkeyHelp.qml</file>
        <file>ui/StereoVolume.qml</file>
        <file>ui/StereoProgress.qml</file>
        <file>ui/StereoMessage.qml</file>
        <file>ui/TopBar.qml</file>
        <file>ui/BottomBar.qml</file>
        <file>ui/CenterPlayBtn.qml</file>
        <file>ui/ProgressSlider.qml</file>
        <file>ui/SeekPreview.qml</file>
        <file>ui/IdleScreen.qml</file>
        <file>ui/VolumePopup.qml</file>
        <file>ui/QualityPopup.qml</file>
        <file>ui/AspectPopup.qml</file>
        <file>ui/AboutPopup.qml</file>
        <file>ui/SpeedPopup.qml</file>
        <file>ui/ContextMenu.qml</file>
        <file>ui/UrlPopup.qml</file>
        <file>ui/PlaylistPanel.qml</file>
        <file>ui/TrueHdrAdvancedPopup.qml</file>
        <file>ui/StereoPicker.qml</file>
        <file>ui/components/IconButton.qml</file>
        <file>ui/components/PopupBase.qml</file>
        <file>ui/components/SegToggle.qml</file>
        <file>ui/components/ParamSliderRow.qml</file>
        <file>ui/components/HotkeyRow.qml</file>
        <!-- 应用图标（About 弹窗显示）= data/vsr-player.svg 的 512 PNG 渲染，
             与桌面图标同一份文件；换图标只需改 SVG 并跑 scripts/render-icon.sh -->
        <file alias="vsr-player.png">../../data/vsr-player.png</file>
    </qresource>
</RCC>
